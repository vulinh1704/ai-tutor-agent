# Copy to .env and adjust. Never commit real keys: .env is git-ignored.

# --- Model provider -----------------------------------------------------------
# openai (default) | anthropic | fake (offline, deterministic: no key needed)
LLM_PROVIDER=fake
# Optional model override. Defaults: openai=gpt-5.4-mini, anthropic=claude-opus-5-5
# LLM_MODEL=
# LLM_MAX_TOKENS=16000
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2

# --- OpenAI (LLM_PROVIDER=openai) ----------------------------------------------
OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=            # Azure OpenAI or any OpenAI-compatible gateway
# OPENAI_REASONING_EFFORT=    # none | minimal | low | medium | high | xhigh
# LLM_TEMPERATURE=            # only honoured by models that accept it (gpt-5: effort "none")

# --- Anthropic Claude (LLM_PROVIDER=anthropic) ------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_EFFORT=medium     # low | medium | high | xhigh | max
# ANTHROPIC_SERVER_FALLBACK=true   # re-run declined requests on Anthropic's fallback model

# --- Agent behaviour ----------------------------------------------------------
# MAX_HINT_LEVEL=3            # 1-5 rungs on the homework hint ladder
# HISTORY_WINDOW=20           # messages sent to the model per turn

# --- Persistence --------------------------------------------------------------
# memory (default, lost on restart) | sqlite (needs the "sqlite" extra)
# Sessions, learner profiles and progress all use this backend.
CHECKPOINTER=memory
# SQLITE_PATH=data/checkpoints.sqlite

# --- Web UI --------------------------------------------------------------------
# Browser origins allowed to call the API (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Pause between streamed words of the offline model, so replies look typed (0 = instant)
# FAKE_STREAM_DELAY_MS=25

LOG_LEVEL=INFO
